# ---- Server ----
PORT=3000

# Origin yang diizinkan memanggil API. Tanpa wildcard.
# Untuk development, frontend disajikan dari origin yang sama jadi boleh kosong.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- HTTPS (OPSIONAL) ----
# Hanya perlu diisi untuk menguji permission dari HP/LAN.
# Camera, microphone, dan geolocation butuh "secure context":
# http://localhost sudah secure, http://192.168.x.x TIDAK.
# Generate cert lokal dengan: npx mkcert -key-file key.pem -cert-file cert.pem localhost 127.0.0.1 192.168.1.10
TLS_CERT_PATH=
TLS_KEY_PATH=

# ---- Google (service account) ----
# Kosongkan semua => backend berjalan dalam MOCK MODE:
# payload di-log ke console dan endpoint tetap merespons sukses.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nGANTI_DENGAN_PRIVATE_KEY_ANDA\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:F
GOOGLE_DRIVE_FOLDER_ID=

# ---- Batas upload ----
MAX_UPLOAD_MB=100
